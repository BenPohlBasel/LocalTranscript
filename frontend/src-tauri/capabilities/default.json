{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Hauptfenster: Dialoge (Öffnen/Speichern), Drag-Drop, Events",
  "windows": ["*"],
  "permissions": [
    "core:default",
    "core:window:allow-set-focus",
    "core:event:default",
    "core:webview:allow-internal-toggle-devtools",
    "dialog:allow-save",
    "dialog:allow-open"
  ]
}
