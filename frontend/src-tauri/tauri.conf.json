{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LocalTranscript",
  "version": "2.1.2",
  "identifier": "city.bias.localtranscript",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LocalTranscript",
        "url": "index.html",
        "width": 1100,
        "height": 800,
        "minWidth": 720,
        "minHeight": 560,
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; img-src 'self' data: blob:; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; media-src 'self' blob: http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/icon.icns",
      "icons/128x128.png",
      "icons/32x32.png"
    ],
    "resources": {
      "resources/python-runtime": "python-runtime",
      "resources/venv": "venv",
      "resources/bin": "bin",
      "resources/lib": "lib",
      "resources/models": "models",
      "resources/BUNDLED": "BUNDLED",
      "../dist": "frontend"
    },
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-"
    }
  }
}
